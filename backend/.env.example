# Copy to backend/.env for local overrides, or use the root .env
# (backend loads root ../../.env then backend/.env — backend wins).

PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fundflow
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Production example (do not commit real values):
# NODE_ENV=production
# PORT=10000
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# JWT_SECRET=use_a_long_random_secret
# CORS_ORIGINS=https://your-frontend.example.com
