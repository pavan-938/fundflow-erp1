# Backend
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fundflow
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Production: set CORS_ORIGINS to your deployed frontend origin only, e.g.
# CORS_ORIGINS=https://your-app.vercel.app
# Never use "*" when credentials are enabled.

# Optional local Postgres via Docker (port 5433 avoids clashes with an existing 5432 service):
# docker run -d --name fundflow-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=fundflow -p 5433:5432 postgres:16-alpine

# Frontend (copy to frontend/.env)
# VITE_API_BASE_URL=http://localhost:4000/api
